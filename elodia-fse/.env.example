# ElodiaTech FSE — Modèle de variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).

# --- Supabase (frontend) ---
VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# --- Supabase service_role (connecteurs Node.js uniquement, JAMAIS exposé au frontend) ---
SUPABASE_KEY=sb_secret_xxxxxxxxxxxx

# --- Email Resend (https://resend.com -> API Keys) ---
VITE_RESEND_API_KEY=re_xxxxxxxxxxxx
VITE_FROM_EMAIL=ElodiaTech FSE <noreply@elodiatech.com>
VITE_APP_URL=http://localhost:3000

# --- Identifiants logiciels médicaux (connecteurs) ---
DOCTOLIB_EMAIL=email@cabinet.com
DOCTOLIB_PASSWORD=motdepasse
MEDISTORY_EMAIL=email@cabinet.com
MEDISTORY_PASSWORD=motdepasse
MAIIA_EMAIL=email@cabinet.com
MAIIA_PASSWORD=motdepasse
